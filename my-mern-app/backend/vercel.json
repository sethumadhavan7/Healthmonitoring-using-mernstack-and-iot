{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": ["routes/**", "models/**"]
            }
        }
    ],
    "routes": [
        {
            "src": "/api/sensors",
            "methods": ["GET", "POST", "OPTIONS"],
            "dest": "/index.js"
        },
        {
            "src": "/api/health",
            "dest": "/index.js"
        },
        {
            "src": "/",
            "dest": "/index.js"
        }
    ]
}
